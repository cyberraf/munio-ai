# ── AI Security Brain — Production Environment ──────────────────────────────
# Copy to .env and fill in values before deploying.

# Domain (used by Caddy for auto-SSL and by the dashboard build)
DOMAIN=demo.aisecuritybrain.com

# ── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_DB=asb
POSTGRES_USER=asb
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here

# ── ClickHouse ──────────────────────────────────────────────────────────────
CLICKHOUSE_PASSWORD=CHANGE_ME_clickhouse_password

# ── Auth ────────────────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@aisecuritybrain.com
ADMIN_PASSWORD=CHANGE_ME_admin_password
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32
ROBOT_API_KEY=CHANGE_ME_robot_api_key
